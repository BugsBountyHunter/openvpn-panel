# openvpn-panel configuration. Copy to .env (dev) or /etc/openvpn-panel/env (server).
# Every value below is optional in demo mode.

# "demo" = fake data for local development/screenshots; "live" = real OpenVPN server.
PANEL_MODE=demo

# Address to bind. Keep 127.0.0.1, or use the server's VPN IP (e.g. 10.8.0.1)
# so the panel is only reachable over the VPN. Never 0.0.0.0 on a public host.
PANEL_HOST=127.0.0.1
PANEL_PORT=8081

# OpenVPN management interface: unix:/path/to.sock or tcp:host:port.
# server/install.sh sets up a 127.0.0.1:7505 bridge to the root-owned socket.
OVPN_MGMT=tcp:127.0.0.1:7505

# Root-owned helper invoked via `sudo -n` for add/revoke/list.
PANEL_HELPER=/usr/local/sbin/openvpn-panel-helper

ADMIN_USER=admin
# Generate with: npm run hash-password   (argon2id or bcrypt hashes are accepted)
# In .env files, escape every "$" as "\$" (dotenv expands variables).
# Demo mode without a hash accepts the password "demo".
ADMIN_PASSWORD_HASH=

# At least 32 random characters, e.g. `openssl rand -hex 32`. Required in live mode.
SESSION_SECRET=

# Append-only JSON-lines audit log.
AUDIT_LOG_PATH=./data/audit.log
